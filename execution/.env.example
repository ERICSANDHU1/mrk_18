# MRK18 Execution System — environment template
# Copy to .env and fill in. NEVER commit .env to git.

# ── Supabase ──────────────────────────────────────────────────────────────
# Use the SESSION POOLER connection string (port 5432) — NEVER the
# transaction pooler (6543): it breaks the LangGraph checkpointer.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
CHECKPOINTER_DSN=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=            # Storage uploads + Auth admin only
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# ── LLM providers (the Brain's seat until Phase 4) ───────────────────────
TOGETHER_API_KEY=                # primary: Qwen/Qwen3-235B-A22B-Instruct-2507-tput
GROQ_API_KEY=                    # fallback + small models

# Phase 4: the trained Brain (vLLM multi-LoRA, OpenAI-compatible)
# BRAIN_BASE_URL=
# BRAIN_API_KEY=

# ── Image generation (engine auto-picked: Cloudflare free > fal > none) ───
CF_ACCOUNT_ID=                   # Cloudflare Workers AI — FREE tier FLUX images
CF_API_TOKEN=                    #   (dash.cloudflare.com → API token w/ Workers AI)
                                 #   the SAME creds also power Company Brain
                                 #   embeddings (@cf/baai/bge-m3, free tier)
FAL_KEY=                         # FLUX.2 klein 4B — production engine (paid)
# GEMINI_API_KEY=                # Nano Banana Pro — text-heavy/Hindi escape hatch (optional)

# ── Observability ─────────────────────────────────────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mrk18-execution

# ── Security (Phase 2 fills these) ────────────────────────────────────────
# SUPABASE_JWKS_URL above is what makes auth work: unset = ALL founder
# endpoints answer 503 (fail closed, never unauthenticated).
APPROVAL_SIGNING_KEY=            # HMAC key for ApprovalEvent signatures + review links
TOKEN_VAULT_KEY=                 # envelope-encryption key for platform tokens
MAINTENANCE_KEY=                 # ops endpoints (X-Maintenance-Key header), e.g. cron expiry

# ── Perimeter (Slice 2.4) ─────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MIN=240
TRUST_PROXY_HEADERS=false        # true ONLY once deployed behind Render/CF proxy
ALERT_WEBHOOK_URL=               # security_alert siren → POST here (Slack/ntfy)

# ── Publishing (go-live only — stubs need nothing) ────────────────────────
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_VERSION=202605        # quarterly bump chore
# X_API_KEY=
