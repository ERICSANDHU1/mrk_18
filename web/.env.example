# ---- Backend (FastAPI on Render) ----
# Server-side routes (app/api/*) proxy here with the Clerk token attached.
BACKEND_URL=http://127.0.0.1:8000
# The free-taster hero calls the backend DIRECTLY from the browser (a RunPod
# cold start outlives serverless proxy timeouts). Public URL only — no secret.
# The backend must list this app's origin in its CORS_ALLOW_ORIGINS.
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# ---- Meta / ad-data connector ----
# "false" = LIVE (Connect Meta button + sync routes work). Unset/anything else =
# locked ("coming soon" + server routes refuse). Until Meta App Review clears,
# only accounts with a role on the Meta app can complete the connect.
NEXT_PUBLIC_CONNECTORS_LOCKED=

# ---- Founding 500 unlock ----
# Comma-separated emails that see Comrk + Chief unlocked in the sidebar; everyone
# else gets the lock + upgrade modal. UI affordance only — /chief and /cowork have
# no server-side gate yet, so this is not a security boundary.
NEXT_PUBLIC_UNLOCKED_EMAILS=

# ---- Clerk authentication ----
# Get these from https://dashboard.clerk.com → your app → API Keys.
# The publishable key is safe to expose (it ships to the browser).
# The secret key is server-only — never commit the real value.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk routing — where the sign-in / sign-up pages live in this app.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Where to land after a successful sign-in / sign-up (Cowork — onboarding first run).
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/cowork
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/cowork

# ---- ElevenLabs Agents (live CMO voice call) ----
# Optional. Leave BOTH blank to use the built-in browser voice call.
# Set the agent id to switch the "Call CMO" voice over to ElevenLabs (Scribe STT +
# a natural male voice + native barge-in). Create a free agent at
# https://elevenlabs.io/app/agents, pick a male voice, then paste its Agent ID here.
# The agent id ships to the browser (public), so make the agent PUBLIC (auth off).
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
# Optional: force a specific ElevenLabs voice id (needs "voice" overrides enabled on
# the agent). Easiest is to just pick the male voice on the agent and leave this blank.
NEXT_PUBLIC_ELEVENLABS_VOICE_ID=
# Per-founder grounding via prompt/voice overrides. Leave blank to start — the agent
# uses its own dashboard prompt + voice (this always connects). Set to 1 ONLY after you
# enable "Overrides" for System prompt / Voice in the agent's Security tab, otherwise
# ElevenLabs rejects the session and the call disconnects immediately.
NEXT_PUBLIC_ELEVENLABS_OVERRIDES=
